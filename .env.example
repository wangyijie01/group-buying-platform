# WeChat sandbox / test account
WEIXIN_ORIGINAL_ID=replace-me
WEIXIN_TOKEN=replace-me
WEIXIN_APP_ID=replace-me
WEIXIN_APP_SECRET=replace-me
WEIXIN_TEMPLATE_ID=replace-me

# Alipay sandbox
ALIPAY_ENABLED=false
ALIPAY_APP_ID=replace-me
ALIPAY_MERCHANT_PRIVATE_KEY=replace-me
ALIPAY_PUBLIC_KEY=replace-me
