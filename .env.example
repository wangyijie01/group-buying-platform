ALIPAY_RETURN_URL=http://127.0.0.1:8070
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Compensation schedules (Spring cron)
GROUP_BUYING_NOTIFY_CRON="0 */1 * * * ?"
GROUP_BUYING_TIMEOUT_REFUND_CRON="0 */5 * * * ?"
