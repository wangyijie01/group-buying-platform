RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=guest
RABBITMQ_PREFETCH=10

# Redis / DCC
REDIS_HOST=127.0.0.1
REDIS_PORT=16379

# Application
MARKET_SERVER_PORT=8091
TRADE_SERVER_PORT=8070
MARKET_API_URL=http://127.0.0.1:8091
MARKET_NOTIFY_URL=http://127.0.0.1:8070/api/v1/alipay/group_buy_notify
